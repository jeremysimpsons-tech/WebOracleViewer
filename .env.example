# Copy to .env or let scripts/install.sh create this file.
# Values are read by Python. Dollar signs are not expanded.
# Quote values that contain spaces. Do not put this file in git.

BIND_HOST=127.0.0.1
BIND_PORT=8080
SESSION_SECRET=
ADMIN_PASSWORD_HASH=
DATA_DIR=data
MASTER_KEY_FILE=data/master.key
COOKIE_SECURE=false
SESSION_MAX_AGE_MINUTES=480
DB_CALL_TIMEOUT_MS=120000
DB_SESSION_IDLE_SECONDS=1800
MAX_FETCH_ROWS=2000
# Absolute directory that wallet folders must live under. Strongly recommended.
WALLET_ROOT=
AUDIT_SQL_TEXT=false
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=600
FORWARDED_ALLOW_IPS=127.0.0.1
SSL_CERTFILE=
SSL_KEYFILE=
LOG_LEVEL=INFO
